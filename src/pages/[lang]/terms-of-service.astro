---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPage from '../../components/LegalPage.astro';
import { ui } from '../../i18n/ui';
import { siteConfig } from '../../config';

export function getStaticPaths() {
  return (['km', 'en', 'zh'] as const).map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
const messages = ui[lang];
const sep = lang === 'zh' ? '｜' : lang === 'km' ? ' · ' : ' | ';
const pageTitle = `${messages.legal?.terms?.title ?? 'Terms of Service'}${sep}${siteConfig.name}`;
---

<BaseLayout lang={lang} messages={messages} path="terms-of-service" robots="noindex, follow" title={pageTitle}>
  <LegalPage lang={lang} messages={messages} kind="terms" />
</BaseLayout>
