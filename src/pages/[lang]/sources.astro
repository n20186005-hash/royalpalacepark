---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sources from '../../components/Sources.astro';
import { ui } from '../../i18n/ui';
export function getStaticPaths() { return (['km', 'en', 'zh'] as const).map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as 'km' | 'en' | 'zh';
const messages = ui[lang];
---
<BaseLayout lang={lang} messages={messages} path="sources" title={`${messages.sources.title} | Royal Palace Park`} subpage>
  <div class="bg-cream px-4 pt-10"><div class="mx-auto max-w-6xl"><a href={`/${lang}`} class="text-sm text-green-deep underline">← {messages.header.siteName}</a></div></div>
  <Sources lang={lang} messages={messages} />
</BaseLayout>
