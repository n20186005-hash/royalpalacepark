---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ui } from '../../../i18n/ui';
import { nearbyAttractions, type Lang } from '../../../data/attractions';
import { details } from '../../../data/attractionDetails';
import { visitorFacts } from '../../../data/visitorFacts';
import { siteConfig } from '../../../config';
export function getStaticPaths() {
  return (['km', 'en', 'zh'] as const).flatMap(lang => nearbyAttractions.map(item => ({ params: { lang, slug: item.slug }, props: { item } })));
}
const lang = Astro.params.lang as Lang;
const { item } = Astro.props;
const detail = details[item.slug];
const facts = visitorFacts[item.slug];
const additional = {
  km: { type: 'ប្រភេទទីតាំង', city: 'ទីក្រុង / ប្រទេស', duration: 'ពេលវេលាណែនាំ', currentReviews: 'មើលមតិអ្នកទស្សនាថ្មីៗ', see: 'ស្វែងយល់', tips: 'គន្លឹះទស្សនា', open: 'ម៉ោងបើក និងការចូល', prices: 'តម្លៃសំបុត្រ', walking: 'ដោយថ្មើរជើង', vehicle: 'តុកតុក / តាក់ស៊ី', charm: 'ប្រវត្តិ ស្ថាបត្យកម្ម និងបទពិសោធន៍', rules: 'ការណែនាំសម្រាប់ភ្ញៀវ', directions: 'អាសយដ្ឋាន និងផែនទី', related: 'ទីតាំងផ្សេងទៀត', updated: 'ព័ត៌មានចូលទស្សនា៖ ពិនិត្យនៅនឹងកន្លែង' },
  en: { type: 'Attraction type', city: 'City / Country', duration: 'Suggested visit length', currentReviews: 'View current visitor reviews', see: 'Explore', tips: 'Visiting tips', open: 'Opening hours and access', prices: 'Ticket and admission prices', walking: 'On foot', vehicle: 'Tuk-tuk / taxi', charm: 'History, architecture and experience', rules: 'Visitor guidelines', directions: 'Address and Google Maps', related: 'Continue exploring nearby', updated: 'Visitor arrangements: check on site' },
  zh: { type: '景点类型', city: '城市／国家', duration: '建议游览时间', currentReviews: '查看最新游客评价', see: '探索景点', tips: '游览建议', open: '开放时间及入场安排', prices: '门票价格', walking: '步行', vehicle: '嘟嘟车／出租车', charm: '发现魅力：历史、建筑、文化与核心体验', rules: '游览须知', directions: '交通指南：具体地址与地图', related: '继续探索周边景点', updated: '游客信息可能变动，请现场核实' },
}[lang];
const txt = {
  km: { all: 'កន្លែងក្បែរៗ', intro: 'សេចក្ដីណែនាំ', history: 'ប្រវត្តិ និងវប្បធម៌', architecture: 'អ្វីគួរសង្កេត', visit: 'ផែនការទស្សនា', basics: 'ព័ត៌មានមូលដ្ឋាន', address: 'អាសយដ្ឋាន', hours: 'ម៉ោងបើក', ticket: 'សំបុត្រ', verify: 'សូមពិនិត្យនៅនឹងកន្លែង; អាចផ្លាស់ប្ដូរ', transport: 'ការធ្វើដំណើរ', transportText: 'អាចដើរពីតំបន់ព្រះបរមរាជវាំង ឬជ្រើសរើសមធ្យោបាយក្នុងទីក្រុង។ ពិនិត្យផ្លូវពិតនៅលើផែនទី។', route: 'ផ្លូវដើរដែលណែនាំ', first: 'ចាប់ផ្ដើមពីឧទ្យានព្រះបរមរាជវាំង', second: 'ទៅកាន់ទីតាំងនេះតាមផ្លូវសុវត្ថិភាព', third: 'សង្កេតមើលទីតាំង ហើយបន្តទៅគោលដៅក្បែរៗ', photo: 'ការថតរូប និងសុវត្ថិភាព', photoText: 'គោរពច្បាប់ថតរូប និងពិធីសាសនា; ប្រើផ្លូវឆ្លងដែលមានសុវត្ថិភាព។', stay: 'ការស្នាក់នៅ', stayText: 'តំបន់ដូនពេញជាមូលដ្ឋានងាយស្រួលសម្រាប់ទស្សនាកណ្ដាលក្រុង; ប្រៀបធៀបទីតាំង និងការធ្វើដំណើរមុនជ្រើសរើស។', reviews: 'មតិអ្នកទស្សនា', reviewsText: 'សូមពិនិត្យមតិថ្មីៗនៅលើផែនទី។', map: 'បើកផែនទី Google', source: 'ឯកសារយោង', about: 'អំពីទីតាំង និងការគ្រប់គ្រង', highlights: 'លក្ខណៈពិសេស', spots: 'ទីតាំងថតរូប', faq: 'សំណួរញឹកញាប់' },
  en: { all: 'Nearby attractions', intro: 'Overview', history: 'History and culture', architecture: 'What to notice', visit: 'Visiting advice', basics: 'Essential information', address: 'Address', hours: 'Opening hours', ticket: 'Admission', verify: 'Check locally; arrangements may change', transport: 'Getting there', transportText: 'Walk from the Royal Palace Park area where practical, or use local transport. Confirm your route on the map before setting out.', route: 'Suggested walking sequence', first: 'Start at Royal Palace Park', second: 'Follow a safe route to this attraction', third: 'Explore the site and continue to a nearby landmark', photo: 'Photos and etiquette', photoText: 'Respect photography restrictions and religious activities; use safe crossings and avoid blocking access.', stay: 'Where to stay', stayText: 'Daun Penh is a convenient central base for visiting this area; compare walking distances and transport before choosing accommodation.', reviews: 'Visitor impressions', reviewsText: 'Consult current visitor feedback on the linked map.', map: 'Open Google Maps', source: 'Reference source', about: 'About this place and its stewardship', highlights: 'What makes it distinctive', spots: 'Photo viewpoints', faq: 'Frequently asked questions' },
  zh: { all: '周边景点', intro: '景点概览', history: '历史与文化', architecture: '建筑与观察重点', visit: '游览建议', basics: '基本信息', address: '具体地址', hours: '开放时间', ticket: '门票', verify: '以现场核实为准，安排可能调整', transport: '交通方式', transportText: '可视距离从王宫公园步行前往，或乘坐市区交通工具；出发前请在地图核对实际路线。', route: '推荐步行路线', first: '从王宫公园出发', second: '沿安全步行路线前往该景点', third: '参观后继续探索周边地标', photo: '拍照与参观须知', photoText: '遵守场所拍照规则和宗教礼仪，注意安全过街，不妨碍通行。', stay: '住宿建议', stayText: '隆边区适合作为市中心景点的住宿据点，选择前可比较步行距离与交通条件。', reviews: '游客评价', reviewsText: '请通过地图查看最新游客评价。', map: '在 Google 地图查看', source: '资料来源', about: '关于景点与管理主体', highlights: '特色与核心体验', spots: '推荐拍照机位', faq: '常见问题' },
}[lang];
const map = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${item.name.en}, ${item.address}`)}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${siteConfig.baseUrl}/${lang}/attractions/${item.slug}#place`,
  name: item.name[lang],
  alternateName: item.name.en,
  description: item.intro[lang],
  url: `${siteConfig.baseUrl}/${lang}/attractions/${item.slug}`,
  image: `${siteConfig.baseUrl}/attractions/${item.slug}.jpg`,
  address: { '@type': 'PostalAddress', streetAddress: item.address, addressLocality: 'Phnom Penh', addressCountry: 'KH' },
  hasMap: map,
  mainEntityOfPage: `${siteConfig.baseUrl}/${lang}/attractions/${item.slug}`,
};
---
<BaseLayout lang={lang} messages={ui[lang]} path={`attractions/${item.slug}`} title={`${item.name[lang]} · Phnom Penh | Royal Palace Park`} description={item.intro[lang]} subpage>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <article class="bg-cream text-charcoal">
    <div class="mx-auto max-w-5xl px-4 py-14 md:py-20">
      <a href={`/${lang}/attractions`} class="text-sm font-medium text-green-deep underline">← {txt.all}</a>
      <p class="section-eyebrow mt-7">Phnom Penh · Cambodia</p>
      <h1 class="mt-2 font-serif text-4xl font-bold text-green-deep md:text-5xl">{item.name[lang]}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed">{item.intro[lang]}</p>
      <div class="mt-5 flex flex-wrap gap-3 text-sm">
        <a href={map} target="_blank" rel="noopener noreferrer" class="rounded-full border border-gold/40 bg-white px-4 py-2 text-green-deep underline">Google Maps · {additional.currentReviews} ↗</a>
        <span class="rounded-full border border-gold/40 bg-white px-4 py-2 text-charcoal/80">{facts.category[lang]}</span>
        <span class="rounded-full border border-gold/40 bg-white px-4 py-2 text-charcoal/80">{facts.duration[lang]}</span>
      </div>
      <a href={map} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex rounded-full bg-green-deep px-6 py-3 font-semibold text-white">{txt.map} ↗</a>
      <figure class="mt-8 overflow-hidden rounded-2xl"><img src={item.slug === 'royal-palace' ? '/gallery/royal-palace-park-2.jpg' : `/attractions/${item.slug}.jpg`} width="960" height="640" alt={item.name[lang]} class="max-h-[520px] w-full object-cover" /><figcaption class="mt-2 text-xs text-charcoal/60">{item.name[lang]} · Phnom Penh</figcaption></figure>
      <section id="explore" class="mt-12"><p class="section-eyebrow">{additional.see}</p><h2 class="mt-2 font-serif text-3xl font-bold text-green-deep">{txt.intro} · {item.name[lang]}</h2><p class="mt-4 max-w-3xl leading-relaxed">{item.intro[lang]}</p></section>
      <div class="mt-9 grid gap-6 md:grid-cols-2">
        <section class="glass-card rounded-2xl p-7"><h2 class="font-serif text-2xl font-bold text-green-deep">{additional.tips}</h2><p class="mt-4 leading-relaxed">{item.visit[lang]}</p><p class="mt-4 text-sm text-charcoal/70">{facts.duration[lang]}</p></section>
        <section class="glass-card rounded-2xl p-7"><h2 class="font-serif text-2xl font-bold text-green-deep">{txt.highlights}</h2><p class="mt-4 leading-relaxed">{detail.highlight[lang]}</p></section>
      </div>
      <section class="mt-10 rounded-2xl border border-gold/30 bg-sand/60 p-7 md:p-9" aria-labelledby="stewardship-heading"><h2 id="stewardship-heading" class="font-serif text-2xl font-bold text-green-deep">{txt.about}</h2><p class="mt-4 leading-relaxed">{detail.stewardship[lang]}</p></section>
      <section id="basics" class="mt-14"><h2 class="font-serif text-3xl font-bold text-green-deep">{txt.basics}</h2><dl class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="glass-card rounded-xl p-5"><dt class="text-sm font-semibold text-green-deep">{additional.type}</dt><dd class="mt-2">{facts.category[lang]}</dd></div>
        <div class="glass-card rounded-xl p-5"><dt class="text-sm font-semibold text-green-deep">{additional.city}</dt><dd class="mt-2">Phnom Penh · Cambodia</dd></div>
        <div class="glass-card rounded-xl p-5"><dt class="text-sm font-semibold text-green-deep">{txt.address}</dt><dd class="mt-2">{item.address}</dd></div>
        <div class="glass-card rounded-xl p-5"><dt class="text-sm font-semibold text-green-deep">{additional.duration}</dt><dd class="mt-2">{facts.duration[lang]}</dd></div>
      </dl></section>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <section id="hours" class="rounded-2xl border border-gold/30 bg-white/80 p-7"><h2 class="font-serif text-2xl font-bold text-green-deep">{additional.open}</h2><p class="mt-4 leading-relaxed">{facts.time[lang]}</p><p class="mt-4 text-xs text-charcoal/60">{additional.updated}</p></section>
        <section id="tickets" class="rounded-2xl border border-gold/30 bg-white/80 p-7"><h2 class="font-serif text-2xl font-bold text-green-deep">{additional.prices}</h2><p class="mt-4 leading-relaxed">{facts.admission[lang]}</p>{facts.source && <a class="mt-4 inline-block break-all text-xs text-green-deep underline" href={facts.source} target="_blank" rel="noopener noreferrer">{txt.source} ↗</a>}</section>
      </div>
      <section id="transport" class="mt-14"><h2 class="font-serif text-3xl font-bold text-green-deep">{txt.transport}</h2><div class="mt-6 grid gap-5 md:grid-cols-2"><div class="glass-card rounded-2xl p-6"><h3 class="font-semibold text-green-deep">{additional.walking}</h3><p class="mt-3 leading-relaxed">{facts.walk[lang]}</p></div><div class="glass-card rounded-2xl p-6"><h3 class="font-semibold text-green-deep">{additional.vehicle}</h3><p class="mt-3 leading-relaxed">{facts.vehicle[lang]}</p></div></div></section>
      <section id="culture" class="mt-14"><h2 class="font-serif text-3xl font-bold text-green-deep">{additional.charm}</h2><div class="mt-6 grid gap-8 md:grid-cols-2"><div><h3 class="font-serif text-xl font-semibold text-green-deep">{txt.history}</h3><p class="mt-3 leading-relaxed">{item.history[lang]}</p></div><div><h3 class="font-serif text-xl font-semibold text-green-deep">{txt.architecture}</h3><p class="mt-3 leading-relaxed">{item.architecture[lang]}</p></div><div class="md:col-span-2"><h3 class="font-serif text-xl font-semibold text-green-deep">{txt.highlights}</h3><p class="mt-3 leading-relaxed">{facts.experience[lang]}</p></div></div></section>
      <section id="route" class="mt-14 rounded-2xl bg-sand/60 p-7"><h2 class="font-serif text-3xl font-bold text-green-deep">{txt.route}</h2><ol class="mt-6 space-y-4">{detail.route.map((step, i) => <li class="flex items-start gap-4"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-green-deep font-semibold text-white">{i + 1}</span><p class="pt-1 leading-relaxed">{step[lang]}</p></li>)}</ol></section>
      <section id="guidelines" class="mt-14"><h2 class="font-serif text-3xl font-bold text-green-deep">{additional.rules}</h2><p class="mt-4 leading-relaxed">{facts.etiquette[lang]}</p><p class="mt-3 leading-relaxed">{txt.photoText}</p></section>
      <section id="photos" class="mt-14"><h2 class="font-serif text-3xl font-bold text-green-deep">{txt.spots}</h2><ol class="mt-6 grid gap-4 md:grid-cols-2">{detail.photoSpots.map((spot, i) => <li class="glass-card rounded-2xl p-5"><span class="font-semibold text-green-deep">{i + 1}. </span>{spot[lang]}</li>)}</ol></section>
      <div class="mt-14 grid gap-8 md:grid-cols-2"><section><h2 class="font-serif text-2xl font-bold text-green-deep">{txt.stay}</h2><p class="mt-3 leading-relaxed">{txt.stayText}</p></section><section><h2 class="font-serif text-2xl font-bold text-green-deep">{txt.reviews}</h2><p class="mt-3 leading-relaxed">{txt.reviewsText}</p><a href={map} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block font-semibold text-green-deep underline">{additional.currentReviews} ↗</a></section></div>
      <section id="directions" class="mt-14 rounded-2xl border border-gold/30 p-7"><h2 class="font-serif text-3xl font-bold text-green-deep">{additional.directions}</h2><p class="mt-4 leading-relaxed">{item.address}</p><p class="mt-3 leading-relaxed">{facts.walk[lang]}</p><a href={map} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex rounded-full bg-green-deep px-5 py-3 font-semibold text-white">{txt.map} ↗</a></section>
      <section class="mt-14"><h2 class="font-serif text-2xl font-bold text-green-deep">{txt.faq}</h2><div class="mt-5 space-y-4">{detail.faq.map(faq => <details class="glass-card rounded-xl p-5"><summary class="cursor-pointer font-semibold text-green-deep">{faq.q[lang]}</summary><p class="mt-3 leading-relaxed">{faq.a[lang]}</p></details>)}</div></section>
      <section class="mt-12 border-t border-gold/30 pt-8"><h2 class="font-serif text-xl font-bold text-green-deep">{txt.source}</h2><a class="mt-3 inline-block break-all text-sm text-green-deep underline" href={item.source} target="_blank" rel="noopener noreferrer">Tourism / heritage information ↗</a><p class="mt-3 text-sm">{txt.verify}</p></section>
      <section class="mt-12"><h2 class="font-serif text-2xl font-bold text-green-deep">{additional.related}</h2><div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{nearbyAttractions.filter(other => other.slug !== item.slug).slice(0, 6).map(other => <a href={`/${lang}/attractions/${other.slug}`} class="glass-card overflow-hidden rounded-xl"><img src={`/attractions/${other.slug}.jpg`} alt={other.name[lang]} width="960" height="640" loading="lazy" class="h-32 w-full object-cover"/><span class="block p-4 font-semibold text-green-deep">{other.name[lang]} →</span></a>)}</div></section>
      <a href={`/${lang}/attractions`} class="mt-10 inline-block font-semibold text-green-deep underline">← {txt.all}</a>
    </div>
  </article>
</BaseLayout>
