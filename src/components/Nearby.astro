---
import Icon from './Icon.astro';
import { nearbyAttractions } from '../data/attractions';

interface Props {
  lang: string;
  messages: any;
}
const { messages, lang } = Astro.props;
const near = messages.nearby;
const spots = near.spots ?? [];
const route = near.route;
const steps = route?.steps ?? [];
---

<section id="nearby" class="scroll-mt-20 bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{near.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{near.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{near.subtitle}</p>
    <a href={`/${lang}/attractions`} class="mt-5 inline-flex rounded-full bg-green-deep px-5 py-3 text-sm font-semibold text-white hover:bg-green">
      {lang === 'zh' ? '探索更多周边景点与独立指南 →' : lang === 'km' ? 'ស្វែងយល់ទីតាំងក្បែរៗបន្ថែម →' : 'Explore more nearby attraction guides →'}
    </a>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        spots.map((s: any) => (
          <article class="glass-card flex items-start gap-3 rounded-2xl p-5">
            <span class="rounded-full bg-green-deep/10 p-2 text-green-deep">
              <Icon name={s.icon ?? 'pin'} class="w-5 h-5" />
            </span>
            <div>
              <h3 class="font-serif text-base font-semibold text-charcoal">{s.name}</h3>
              <p class="mt-1 text-xs text-charcoal/50">{s.distance}</p>
              <p class="mt-2 text-sm leading-relaxed text-charcoal/75">{s.desc}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {nearbyAttractions.map(item => (
        <a href={`/${lang}/attractions/${item.slug}`} class="glass-card group overflow-hidden rounded-2xl transition hover:-translate-y-1 hover:shadow-lg">
          <img src={`/attractions/${item.slug}.jpg`} alt={item.name[lang as 'km' | 'en' | 'zh']} loading="lazy" width="960" height="640" class="h-44 w-full object-cover" />
          <div class="p-5">
            <h3 class="font-serif text-lg font-bold text-green-deep">{item.name[lang as 'km' | 'en' | 'zh']}</h3>
            <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-charcoal/70">{item.intro[lang as 'km' | 'en' | 'zh']}</p>
            <span class="mt-3 inline-block text-sm font-semibold text-green-deep group-hover:underline">{lang === 'zh' ? '查看景点详情 →' : lang === 'km' ? 'មើលព័ត៌មានបន្ថែម →' : 'Read the guide →'}</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-10 rounded-2xl border border-gold/30 bg-sand/60 p-6">
      <div class="flex items-center gap-2 text-green-deep">
        <Icon name="route" class="w-5 h-5" />
        <h3 class="font-serif text-lg font-semibold">{route.title}</h3>
      </div>
      <p class="mt-2 text-sm text-charcoal/70">{route.intro}</p>
      <ol class="mt-5 space-y-4">
        {
          steps.map((step: any, i: number) => (
            <li class="flex items-start gap-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-green-deep font-semibold text-white">
                {i + 1}
              </span>
              <div class="flex-1">
                <p class="font-medium text-charcoal">{step.place}</p>
                <p class="text-sm text-charcoal/70">{step.note}</p>
              </div>
              <span class="shrink-0 text-xs font-semibold text-gold-deep">{step.time}</span>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-xs text-charcoal/55">{route.note}</p>
    </div>
  </div>
</section>
