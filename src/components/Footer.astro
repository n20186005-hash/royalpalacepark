---
interface Props {
  lang: string;
  messages: any;
}
const { lang, messages } = Astro.props;
const footer = messages.footer;
const rights = lang === 'zh' ? '版權所有' : lang === 'km' ? 'រក្សាសិទ្ធិគ្រប់យ៉ាង' : 'All rights reserved';
const independent = lang === 'zh' ? '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。' : lang === 'km' ? 'គេហទំព័រនេះជាគម្រោងព័ត៌មានទេសចរណ៍ឯករាជ្យ។ យើងមិនមានទំនាក់ទំនងជាមួយស្ថាប័នរដ្ឋាភិបាល ឬអង្គការផ្លូវការណាមួយឡើយ។' : 'This website is an independent travel information project. We are not affiliated with any government agency or official organisation.';
---

<footer class="bg-green-deep text-cream">
  <div class="mx-auto flex max-w-6xl flex-col gap-5 px-4 py-8 md:flex-row md:items-start md:justify-between">
    <div class="space-y-2 text-sm leading-relaxed text-cream/85">
      <p>© 2026 {footer.siteName} · {rights}</p>
      <p>{independent}</p>
    </div>
    <nav aria-label="Site policies" class="flex shrink-0 flex-wrap gap-x-5 gap-y-2 text-sm md:justify-end">
      <a href={`/${lang}/privacy-policy`} class="hover:text-gold">{footer.privacy}</a>
      <a href={`/${lang}/terms-of-service`} class="hover:text-gold">{footer.terms}</a>
      <a href={`/${lang}/cookie-settings`} class="hover:text-gold">{footer.cookie}</a>
    </nav>
  </div>
</footer>
