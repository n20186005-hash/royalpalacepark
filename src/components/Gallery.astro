---
import Icon from './Icon.astro';
import { landmarkNames, mapsUrl, siteConfig } from '../config';

interface Props {
  lang: string;
  messages: any;
}
const { lang, messages } = Astro.props;
const gallery = messages.gallery;
const photos = gallery.photos ?? [];
const [landmark1, landmark2] = landmarkNames(lang);

function semanticAlt(rawAlt: string, index: number): string {
  const full = siteConfig.fullName;
  const short = siteConfig.shortName;
  const city = siteConfig.city;
  const country = siteConfig.country;
  if (index === 0) {
    return `${full} - Main view in ${city}, ${country}`;
  }
  if (index === 1) {
    return `${full} - Royal architecture view from ${short} in ${city}`;
  }
  if (index === 2) {
    return `${full} - Walking path through the park in ${city}`;
  }
  if (index === 3) {
    return `${full} - Visitors relaxing on the lawn in ${city}`;
  }
  if (index === 4) {
    return `${full} - Phnom Penh city skyline beyond the palace grounds`;
  }
  if (index === 5) {
    return `${landmark1} near ${short} - Tonle Sap river and riverside`;
  }
  if (index === 6) {
    return `${full} - Evening light over the palace area in ${city}, ${country}`;
  }
  if (index === 7) {
    return `${full} - Garden plants and shaded benches in ${city}`;
  }
  if (index === 8) {
    return `${full} - Street scene near Sothearos Blvd in ${city}`;
  }
  if (index === 9) {
    return `${full} - Wide view of the park and palace gates in ${city}`;
  }
  if (index === 10) {
    return `${full} - Local life and vendors near the area in ${city}`;
  }
  if (index === 11) {
    return `${landmark2} near ${short} - Central Phnom Penh aerial style view`;
  }
  if (index === 12) {
    return `${full} - Another view around ${short} in ${city}, ${country}`;
  }
  return rawAlt ?? `${full} in ${city}, ${country}`;
}
---

<section id="gallery" class="scroll-mt-20 bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{gallery.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{gallery.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{gallery.subtitle}</p>

    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {
        photos.map((p: any, i: number) => (
          <figure class="group overflow-hidden rounded-2xl border border-gold/20 bg-sand">
            <img
              src={`/gallery/${p.file}`}
              alt={semanticAlt(p.alt, i)}
              loading="lazy"
              class="h-44 w-full object-cover transition duration-500 group-hover:scale-105"
            />
            <figcaption class="px-3 py-2 text-xs text-charcoal/70">{p.caption}</figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-4 rounded-2xl bg-sand/70 p-5 sm:flex-row sm:items-center">
      <div class="flex flex-wrap gap-4 text-sm font-medium text-green-deep">
        <a href={`/${lang}/image-credits`} class="underline">{gallery.creditNote ? (lang === 'zh' ? '图片来源 →' : lang === 'km' ? 'ប្រភពរូបភាព →' : 'Image credits →') : ''}</a>
        <a href={`/${lang}/sources`} class="underline">{messages.sources.title} →</a>
        <a href={`/${lang}/about`} class="underline">{messages.footer.missionTitle} →</a>
      </div>
      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-2 rounded-full border border-green-deep px-5 py-2 text-sm font-semibold text-green-deep transition hover:bg-green-deep hover:text-white"
      >
        <Icon name="map" class="w-4 h-4" />
        {gallery.viewMaps}
      </a>
    </div>
  </div>
</section>
