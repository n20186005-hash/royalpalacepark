---
import Icon from './Icon.astro';

interface Props {
  lang: string;
  messages: any;
}
const { lang, messages } = Astro.props;
const season = messages.season ?? {};
const rows = season.rows ?? [];
---

<section id="season" class="scroll-mt-20 bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{season.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{season.title}</h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-charcoal/75">{season.subtitle}</p>
    {season.note && <p class="mt-2 text-xs leading-relaxed text-charcoal/55">{season.note}</p>}

    {
      rows.length ? (
        <div class="mt-8 overflow-hidden rounded-2xl border border-gold/25 bg-white/60 shadow-sm">
          <div class="hidden md:grid md:grid-cols-5 border-b border-gold/20 bg-sand/50 text-xs font-semibold text-green-deep">
            <div class="px-5 py-3">{season.cols?.quarter ?? 'Season'}</div>
            <div class="px-5 py-3">{season.cols?.weather ?? 'Climate'}</div>
            <div class="px-5 py-3">{season.cols?.water ?? 'River & water'}</div>
            <div class="px-5 py-3">{season.cols?.wildlife ?? 'Nature'}</div>
            <div class="px-5 py-3">{season.cols?.tips ?? 'Visit tips'}</div>
          </div>
          <ul class="divide-y divide-gold/20">
            {
              rows.map((r: any) => (
                <li class="grid gap-3 md:grid-cols-5 md:gap-0 px-4 py-5 md:px-0">
                  <div class="md:px-5">
                    <p class="flex items-center gap-2 font-serif text-base font-semibold text-charcoal">
                      <Icon name="calendar" class="w-5 h-5 text-gold-deep" />
                      {r.quarter}
                    </p>
                    <p class="mt-1 text-xs text-charcoal/55 md:hidden">{season.cols?.quarter ?? 'Season'}</p>
                    {r.months && <p class="mt-1 text-xs text-charcoal/60">{r.months}</p>}
                  </div>
                  <div class="md:px-5">
                    <p class="text-xs font-semibold text-charcoal/55 md:hidden">{season.cols?.weather ?? 'Climate'}</p>
                    <p class="mt-1 text-sm leading-relaxed text-charcoal/80">{r.weather}</p>
                    {r.temp && <p class="mt-1 text-xs text-green-deep">{r.temp}</p>}
                  </div>
                  <div class="md:px-5">
                    <p class="text-xs font-semibold text-charcoal/55 md:hidden">{season.cols?.water ?? 'River & water'}</p>
                    <p class="mt-1 text-sm leading-relaxed text-charcoal/80">{r.water}</p>
                  </div>
                  <div class="md:px-5">
                    <p class="text-xs font-semibold text-charcoal/55 md:hidden">{season.cols?.wildlife ?? 'Nature'}</p>
                    <p class="mt-1 text-sm leading-relaxed text-charcoal/80">{r.wildlife}</p>
                  </div>
                  <div class="md:px-5">
                    <p class="text-xs font-semibold text-charcoal/55 md:hidden">{season.cols?.tips ?? 'Visit tips'}</p>
                    <ul class="mt-1 space-y-1 text-sm leading-relaxed text-charcoal/80">
                      {(r.tips ?? []).map((t: string) => <li class="flex items-start gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-deep" />{t}</li>)}
                    </ul>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      ) : null
    }
  </div>
</section>
