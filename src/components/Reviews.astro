---
import Icon from './Icon.astro';
import { attraction, mapsUrl, siteConfig } from '../config';

interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const reviews = messages.reviews ?? {};

const ratingValue = Number(attraction.rating) || 0;
const reviewsCount = attraction.reviewsCount;
const stars = [0, 1, 2, 3, 4].map((i) => {
  const rest = ratingValue - i;
  return rest >= 1 ? 'full' : rest >= 0.5 ? 'half' : 'empty';
});

// 评分与评价数同步自谷歌地图（Google Maps）用户评价
const sourceName = siteConfig.reviewsSourceName;
---

<section id="reviews" class="scroll-mt-20 bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{reviews.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{reviews.title}</h2>
    {reviews.subtitle && <p class="mt-4 max-w-3xl text-base leading-relaxed text-charcoal/75">{reviews.subtitle}</p>}

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <div class="glass-card rounded-2xl p-6">
        <p class="text-xs uppercase tracking-wide text-charcoal/55">{reviews.ratingLabel}</p>
        <p class="mt-2 font-serif text-4xl font-bold text-green-deep">
          {attraction.rating}<span class="text-lg font-semibold text-charcoal/60"> / 5</span>
        </p>

        <div class="mt-3 flex items-center gap-1" role="img" aria-label={`${attraction.rating} / 5`}>
          {
            stars.map((state) => (
              <Icon
                name="star"
                class={state === 'full' ? 'w-5 h-5 text-gold' : state === 'half' ? 'w-5 h-5 text-gold/50' : 'w-5 h-5 text-charcoal/20'}
              />
            ))
          }
        </div>

        <p class="mt-4 text-sm text-charcoal/70">
          <strong class="text-charcoal">{reviewsCount}</strong>
          {reviews.reviewsLabel}
        </p>

        <p class="mt-2 text-xs text-charcoal/55">{reviews.disclaimer}</p>
      </div>

      <div class="md:col-span-2 flex flex-col justify-between rounded-2xl border border-gold/40 bg-sand/50 p-6">
        <div>
          <h3 class="font-serif text-lg font-semibold text-green-deep">{reviews.sourceTitle}</h3>
          <p class="mt-2 text-sm leading-relaxed text-charcoal/80">{reviews.sourceNote}</p>
          <p class="mt-3 text-xs leading-relaxed text-charcoal/60">{reviews.copyright}</p>
        </div>

        <div class="mt-5">
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-green-deep px-5 py-3 text-sm font-semibold text-white shadow transition hover:bg-green"
          >
            <Icon name="map" class="w-4 h-4" />
            {reviews.viewAll}
          </a>

          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 block text-xs leading-relaxed text-charcoal/60 underline decoration-dotted underline-offset-4 transition hover:text-green-deep"
          >
            {reviews.syncNote}
          </a>
          <p class="mt-1 text-[0.7rem] text-charcoal/50">{sourceName} · {siteConfig.reviewsSyncLabel}</p>
        </div>
      </div>
    </div>
  </div>
</section>
