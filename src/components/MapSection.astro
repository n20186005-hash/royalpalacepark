---
import Icon from './Icon.astro';
import { govtTourismUrl, mapsUrl, mapsEmbedSrc, officialLinks, siteConfig } from '../config';

interface Props {
  lang: string;
  messages: any;
}
const { lang, messages } = Astro.props;
const map = messages.map;
const govtLabel = lang === 'zh' ? '柬埔寨 / 金边 官方旅游门户' : lang === 'km' ? 'វិបផតថលទេសចរណ៍ផ្លូវការ កម្ពុជា / ភ្នំពេញ' : 'Cambodia / Phnom Penh Official Tourism Portal';
---

<section id="map" class="scroll-mt-20 bg-sand/60 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{map.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{map.title}</h2>
    <p class="mt-3 max-w-2xl text-charcoal/70">{map.subtitle}</p>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <div class="glass-card rounded-2xl p-6 md:col-span-1">
        <div class="space-y-4">
          <div>
            <p class="text-xs uppercase tracking-wide text-charcoal/55">{map.addressLabel}</p>
            <p class="mt-1 font-medium text-charcoal">{map.addressValue}</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-wide text-charcoal/55">{map.hoursLabel}</p>
            <p class="mt-1 font-medium text-charcoal">{map.hoursValue}</p>
          </div>
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-green-deep px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-green"
          >
            <Icon name="map" class="w-4 h-4" />
            {map.openLabel}
          </a>

          <div class="pt-2 border-t border-gold/25">
            <p class="text-xs leading-relaxed text-charcoal/70">
              {lang === 'zh' ? '如需官方更新与区域旅游信息，请访问 ' : lang === 'km' ? 'សម្រាប់ព័ត៌មានផ្លូវការ និងព័ត៌មានទេសចរណ៍តំបន់ សូមចូលមើល ' : 'For official updates and regional tourism information, visit '}
              <a
                href={govtTourismUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-dotted underline-offset-4 text-green-deep hover:text-gold-deep"
              >
                {govtLabel}
              </a>
              。
            </p>
          </div>
        </div>
      </div>

      <div class="overflow-hidden rounded-2xl border border-gold/30 shadow-lg md:col-span-2">
        <iframe
          title={map.title}
          src={mapsEmbedSrc}
          width="100%"
          height="450"
          style="border:0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          class="h-72 w-full md:h-[450px]"
        ></iframe>
      </div>
    </div>
  </div>
</section>
