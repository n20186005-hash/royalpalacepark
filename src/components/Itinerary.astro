---
import Icon from './Icon.astro';

interface Props {
  lang: string;
  messages: any;
}
const { lang, messages } = Astro.props;
const iti = messages.itinerary ?? {};
const half = iti.half ?? {};
const full = iti.full ?? {};
---

<section id="itinerary" class="scroll-mt-20 bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{iti.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{iti.title}</h2>
    {iti.subtitle && <p class="mt-3 max-w-2xl text-sm leading-relaxed text-charcoal/75">{iti.subtitle}</p>}

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <article class="glass-card rounded-2xl p-6">
        <div class="flex items-center justify-between">
          <h3 class="font-serif text-xl font-semibold text-charcoal">
            <Icon name="clock-half" class="mr-2 inline w-5 h-5 text-gold-deep" />
            {half.title}
          </h3>
          <span class="rounded-full bg-green-deep/10 px-3 py-1 text-xs font-semibold text-green-deep">{half.duration}</span>
        </div>
        {half.intro && <p class="mt-3 text-sm leading-relaxed text-charcoal/75">{half.intro}</p>}
        <ol class="mt-5 space-y-4">
          {
            (half.steps ?? []).map((s: any, i: number) => (
              <li class="flex items-start gap-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-green-deep font-semibold text-white">{i + 1}</span>
                <div class="flex-1">
                  <p class="text-xs text-charcoal/55">{s.time}</p>
                  <p class="font-medium text-charcoal">{s.place}</p>
                  {s.note && <p class="mt-1 text-sm leading-relaxed text-charcoal/70">{s.note}</p>}
                </div>
              </li>
            ))
          }
        </ol>
        {half.suitable && <p class="mt-5 rounded-xl bg-sand/60 px-3 py-2 text-xs text-charcoal/70">{iti.suitable ?? 'Suitable for'}：{half.suitable}</p>}
      </article>

      <article class="glass-card rounded-2xl p-6">
        <div class="flex items-center justify-between">
          <h3 class="font-serif text-xl font-semibold text-charcoal">
            <Icon name="clock-full" class="mr-2 inline w-5 h-5 text-gold-deep" />
            {full.title}
          </h3>
          <span class="rounded-full bg-gold/20 px-3 py-1 text-xs font-semibold text-gold-deep">{full.duration}</span>
        </div>
        {full.intro && <p class="mt-3 text-sm leading-relaxed text-charcoal/75">{full.intro}</p>}
        <ol class="mt-5 space-y-4">
          {
            (full.steps ?? []).map((s: any, i: number) => (
              <li class="flex items-start gap-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-green-deep font-semibold text-white">{i + 1}</span>
                <div class="flex-1">
                  <p class="text-xs text-charcoal/55">{s.time}</p>
                  <p class="font-medium text-charcoal">{s.place}</p>
                  {s.note && <p class="mt-1 text-sm leading-relaxed text-charcoal/70">{s.note}</p>}
                </div>
              </li>
            ))
          }
        </ol>
        {full.suitable && <p class="mt-5 rounded-xl bg-sand/60 px-3 py-2 text-xs text-charcoal/70">{iti.suitable ?? 'Suitable for'}：{full.suitable}</p>}
      </article>
    </div>
  </div>
</section>
