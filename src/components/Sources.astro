---
import Icon from './Icon.astro';
import { attraction, mapsUrl, siteConfig } from '../config';

interface Props {
  lang: string;
  messages: any;
}
const { messages } = Astro.props;
const sources = messages.sources ?? {};
const reviewsSource = sources.reviews ?? {};
const official = sources.official ?? {};
const officialItems: any[] = official.items ?? [];
const photoRights = sources.photoRights ?? {};
---

<section id="sources" class="scroll-mt-20 border-t border-gold/25 bg-sand/60 py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-4">
    <p class="section-eyebrow">{sources.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-green-deep md:text-4xl">{sources.title}</h2>
    {sources.intro && <p class="mt-4 max-w-3xl text-sm leading-relaxed text-charcoal/75">{sources.intro}</p>}

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="glass-card rounded-2xl p-6">
        <h3 class="flex items-center gap-2 font-serif text-lg font-semibold text-green-deep">
          <Icon name="star" class="w-5 h-5 text-gold" />
          {reviewsSource.label}
        </h3>
        <p class="mt-3 text-sm text-charcoal/80">{reviewsSource.value}</p>
        <p class="mt-2 text-xs text-charcoal/60">{reviewsSource.sync}</p>
        <p class="mt-3 text-xs leading-relaxed text-charcoal/70">{reviewsSource.note}</p>
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-green-deep underline decoration-dotted underline-offset-4 transition hover:text-gold-deep"
        >
          <Icon name="map" class="w-4 h-4" />
          {reviewsSource.linkLabel}
        </a>
      </div>

      <div class="glass-card rounded-2xl p-6">
        <h3 class="flex items-center gap-2 font-serif text-lg font-semibold text-green-deep">
          <Icon name="globe" class="w-5 h-5 text-gold" />
          {official.label}
        </h3>
        <ul class="mt-4 space-y-3">
          {
            officialItems.map((item: any) => (
              <li class="flex items-start gap-2 text-sm">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-deep" />
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-charcoal/80 underline decoration-dotted underline-offset-4 transition hover:text-green-deep"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-gold/40 bg-cream p-6">
        <h3 class="flex items-center gap-2 font-serif text-lg font-semibold text-green-deep">
          <Icon name="photo" class="w-5 h-5 text-gold" />
          {photoRights.label}
        </h3>
        <p class="mt-3 text-xs leading-relaxed text-charcoal/75">{photoRights.text}</p>
      </div>

      <div class="rounded-2xl border border-gold/40 bg-cream p-6">
        <h3 class="flex items-center gap-2 font-serif text-lg font-semibold text-green-deep">
          <Icon name="shield" class="w-5 h-5 text-gold" />
          {sources.independenceTitle}
        </h3>
        <p class="mt-3 text-xs leading-relaxed text-charcoal/75">{sources.independenceText}</p>
        <p class="mt-3 text-[0.7rem] text-charcoal/50">
          {sources.lastReviewed} · {siteConfig.fullName} · {siteConfig.city}, {siteConfig.country}
        </p>
      </div>
    </div>
  </div>
</section>
